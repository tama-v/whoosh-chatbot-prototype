# Copy the values you need into your shell environment before starting the backend.
# The backend has no .env loader; export these variables or use your process manager.
# NEVER expose DASHSCOPE_API_KEY to the browser and never commit real keys.

# Alibaba Cloud Model Studio (DashScope), backend only.
# Leave both empty to run the full demo mode: hybrid retrieval (FTS5 + hashed vectors)
# with extractive answers. Speech then falls back to browser voices; a Windows-hosted
# backend can additionally use SAPI for English.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# Model IDs verified against Alibaba Cloud Model Studio docs (2026-11).
# Chat and embedding models work through the OpenAI-compatible endpoint.
QWEN_CHAT_MODEL=qwen3.7-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4

# Voice models.
# ASR (qwen3-asr-flash) is called through /chat/completions with input_audio.
# TTS uses the non-realtime SpeechSynthesizer API, not the compatible-mode endpoint.
# Without a key both endpoints answer 503 honestly; the web client falls back to
# browser speech recognition and browser speech synthesis.
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE_ID=qwen-audio-3.1-tts-flash-embun_id
# Optional English voice override; empty means the Indonesian voice is used.
QWEN_TTS_VOICE_EN=
# Optional TTS host override, e.g. https://dashscope-intl.aliyuncs.com
QWEN_TTS_API_BASE=

# Demo TTS fallback using Windows SAPI (PowerShell), only available when the
# backend runs on Windows. English voice (Zira) ships with Windows; Indonesian has
# no SAPI voice on most installs and falls back to the browser voice. On Docker/Linux
# the health endpoint reports demo_tts=false and both languages use browser voices.
# Set to 0 to disable the server-side demo engine.
DEMO_TTS_ENABLED=1

# Self-hosted auth (no Supabase). Sessions are HttpOnly cookies on web and
# Bearer tokens for mobile; both expire after SESSION_TTL_DAYS.
SESSION_COOKIE_NAME=whoosh_session
SESSION_TTL_DAYS=7
# Set to 1 when served over HTTPS so the cookie is marked Secure.
SESSION_COOKIE_SECURE=0

# Local admin account. If ADMIN_PASSWORD is empty, the first boot generates a
# random password and writes it to backend/data/admin_bootstrap.txt (never commit
# that file). Set ADMIN_PASSWORD to rotate the password on restart.
ADMIN_EMAIL=admin@whoosh.local
ADMIN_NAME=Admin Whoosh
ADMIN_PASSWORD=

# In-process token-bucket rate limiting (requests per minute per client IP).
RATE_LIMIT_ENABLED=1
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=0
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_VOICE=30
RATE_LIMIT_ADMIN=120
RATE_LIMIT_DEFAULT=240

# Backend overrides
# DATABASE_PATH=backend/data/whoosh_ai_demo.db
# Demo from a phone/another PC on the same Wi-Fi: the browser origin must be
# allowed by CORS. Replace 192.168.1.10 with this computer's LAN IP.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082,http://192.168.1.10:3000,http://192.168.1.10:8082

# Web dev server: where Next.js rewrites /api/v1/* requests.
API_PROXY_URL=http://127.0.0.1:8000

# Expo app (apps/mobile). Optional override; by default the app derives the
# backend host from the Metro/web host on port 8000 (Android emulator: 10.0.2.2).
# For a physical device use the computer's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=
